# MDPlanner v2 — environment variable reference
# Copy this file to .env and fill in values before running docker compose up.

# Absolute path to your data directory inside the container.
# The docker-compose.yml mounts mdplanner-data volume at /data.
PROJECT_DIR=/data

# Set to "false" to disable the SQLite FTS cache (search will not work).
CACHE=true

# HTTP port the server listens on inside the container.
PORT=8003

# Bearer token required on MCP API requests (Authorization: Bearer <token>).
# Leave empty to disable MCP authentication (not recommended in production).
MCP_TOKEN=

# AES-256-GCM encryption key for integration secrets stored in project.md
# (e.g. Cloudflare API token). Leave empty to store tokens in plaintext.
# Generate with: openssl rand -hex 32
MDPLANNER_SECRET_KEY=
